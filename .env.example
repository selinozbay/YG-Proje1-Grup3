# Bu dosyayı ".env.local" adıyla kopyalayıp değerleri doldurun.
# .env.local git'e gönderilmez (.gitignore içinde *.local var).
# Değerler: Firebase Console > Proje ayarları > Genel > Web uygulaması > firebaseConfig
# Değerler boş bırakılırsa uygulama DEMO MODUNDA çalışır (giriş ve veriler yalnızca bu tarayıcıda).

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
